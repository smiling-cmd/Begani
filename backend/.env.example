# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_TIME_ZONE=UTC

# Encryption key for encrypted model fields (required if encryption is enabled)
ENCRYPTION_KEY=

# CORS (ignored while CORS_ALLOW_ALL_ORIGINS is true)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (console backend is used automatically when DEBUG=True)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=False
DJANGO_DEFAULT_FROM_EMAIL=Begani <no-reply@begani.app>

# TUA (Groq). Without this key the TUA endpoint returns 503 instead of breaking startup.
GROQ_API_KEY=
TUA_CHAT_RATE_LIMIT=30/hour

# Payments
PLATFORM_COMMISSION_PERCENT=10

# Password reset emails link back to the React app
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=3600

# Google Sign-In (OAuth "Web application" client ID; same value as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=
